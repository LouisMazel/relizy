{
  "name": "docs",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "description": "Documentation for relizy",
  "author": "Louis Mazel <me@loicmazuel.com>",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "pnpm predocs && pnpm build:only",
    "build:only": "vitepress build",
    "dev": "pnpm predocs && vitepress dev",
    "preview": "vitepress preview",
    "predocs": "typedoc",
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:fix": "cross-env NODE_ENV=production eslint . --fix",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@maz-ui/icons": "^5.5.0",
    "@maz-ui/themes": "^5.5.0",
    "maz-ui": "^5.6.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@maz-ui/translations": "^5.5.0",
    "@tailwindcss/vite": "^4.3.4",
    "tailwindcss": "^4.3.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "^1.14.0",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,md,yml,json}": [
      "eslint --fix"
    ]
  },
  "nx": {
    "implicitDependencies": [
      "relizy"
    ],
    "targets": {
      "build": {
        "dependsOn": [],
        "inputs": [
          "default",
          "{workspaceRoot}/packages/relizy/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/.vitepress/dist",
          "{projectRoot}/src/typedoc"
        ]
      }
    }
  }
}
