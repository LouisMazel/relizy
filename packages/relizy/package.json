{
  "name": "relizy",
  "type": "module",
  "version": "2.3.0-beta.0",
  "packageManager": "pnpm@12.18.0",
  "description": "Release automation - Ship every release in one command",
  "author": "Louis Mazel <me@loicmazuel.com>",
  "license": "MIT",
  "homepage": "https://relizy.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisMazel/relizy.git",
    "directory": "packages/relizy"
  },
  "bugs": "https://github.com/LouisMazel/relizy/issues",
  "keywords": [
    "monorepo",
    "changelog",
    "release",
    "versioning",
    "lerna",
    "semantic-release",
    "conventional-commits",
    "turbo",
    "git-tag",
    "npm-publish",
    "version-bump",
    "changesets",
    "release-automation"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./cli": "./bin/relizy.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "relizy": "bin/relizy.mjs",
    "rly": "bin/relizy.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "agent-docs",
    "bin",
    "dist"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "unbuild",
    "generate:agent-docs": "tsx scripts/generate-agent-docs.ts",
    "ai:eval": "tsx scripts/ai-eval/run.ts",
    "dev": "unbuild --stub",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "@slack/web-api": "^7.0.0 || ^8.0.0",
    "@yoloship/claude-sdk": "^0.2.0-beta.6",
    "ai": "^7.0.0",
    "twitter-api-v2": "^1.20.0"
  },
  "peerDependenciesMeta": {
    "@slack/web-api": {
      "optional": true
    },
    "@yoloship/claude-sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "twitter-api-v2": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@maz-ui/node": "5.7.0-beta.0",
    "@maz-ui/utils": "^5.5.0",
    "@relizy/core": "workspace:^",
    "c12": "^3.3.4",
    "commander": "^15.0.0",
    "defu": "6.1.7",
    "fast-glob": "^3.3.3",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromatch": "^4.0.8",
    "oxc-parser": "^0.157.0",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@slack/web-api": "8.3.0",
    "@types/mdast": "^4.0.4",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@yoloship/claude-sdk": "0.2.0-beta.9",
    "ai": "^7.0.163",
    "memfs": "^4.80.0",
    "minisearch": "^7.2.0",
    "tsx": "^4.23.15",
    "twitter-api-v2": "^1.31.0",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "nx": {
    "targets": {
      "generate:agent-docs": {
        "inputs": [
          "default",
          "{workspaceRoot}/docs/src/**/*",
          "{workspaceRoot}/packages/core/src/**/*",
          {
            "externalDependencies": [
              "tsx"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/agent-docs"
        ],
        "cache": true
      },
      "build": {
        "dependsOn": [
          "^build",
          "generate:agent-docs"
        ]
      },
      "dev": {
        "dependsOn": [
          "^dev",
          "generate:agent-docs"
        ]
      },
      "test:unit": {
        "dependsOn": [
          "generate:agent-docs"
        ]
      }
    }
  }
}
