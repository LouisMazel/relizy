{
  "name": "relizy-monorepo",
  "type": "module",
  "version": "2.3.0-beta.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "description": "Monorepo of relizy and @relizy/core",
  "author": "Louis Mazel <me@loicmazuel.com>",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "prepare": "husky && pnpm relizy mcp update",
    "build": "nx run-many -t build --exclude=docs",
    "dev": "nx run-many -t dev --exclude=docs",
    "relizy": "tsx packages/relizy/src/cli.ts",
    "rly": "tsx packages/relizy/src/cli.ts",
    "typecheck": "nx run-many -t typecheck --exclude=docs",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "lint:all": "pnpm lint",
    "lint:fix:all": "pnpm lint:fix",
    "lint:docs": "nx run docs:lint",
    "lint:docs:fix": "nx run docs:lint:fix",
    "test:unit": "cross-env NX_LOAD_DOT_ENV_FILES=false nx run-many -t test:unit",
    "test:unit:watch": "cross-env NX_LOAD_DOT_ENV_FILES=false nx run relizy-monorepo:test:unit:watch",
    "test:unit:coverage": "cross-env NX_LOAD_DOT_ENV_FILES=false nx run relizy-monorepo:test:unit:coverage",
    "health": "cross-env NX_LOAD_DOT_ENV_FILES=false nx run-many -t typecheck lint:fix test:unit:coverage build --parallel=1",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@maz-ui/eslint-config": "^5.5.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "10.1.0",
    "eslint": "^10.14.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "^17.6.0",
    "nx": "^24.0.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,md,yml,json}": [
      "eslint --fix"
    ]
  },
  "nx": {
    "includedScripts": []
  }
}
