{
  "name": "relizy",
  "type": "module",
  "version": "1.14.4-beta.0",
  "packageManager": "pnpm@12.4.1",
  "description": "Release automation for monorepos and single packages, driven by your commits: versions, changelogs, npm publishing, GitHub and GitLab releases",
  "author": "Louis Mazel <me@loicmazuel.com>",
  "license": "MIT",
  "homepage": "https://relizy.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisMazel/relizy.git"
  },
  "bugs": "https://github.com/LouisMazel/relizy/issues",
  "keywords": [
    "monorepo",
    "changelog",
    "release",
    "versioning",
    "lerna",
    "semantic-release",
    "conventional-commits",
    "turbo",
    "git-tag",
    "npm-publish",
    "version-bump",
    "changesets",
    "release-automation"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./cli": "./bin/relizy.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "relizy": "bin/relizy.mjs",
    "rly": "bin/relizy.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "agent-docs",
    "bin",
    "dist"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "prepare": "npx husky",
    "build": "pnpm generate:agent-docs && unbuild",
    "generate:agent-docs": "tsx scripts/generate-agent-docs.ts",
    "ai:eval": "tsx scripts/ai-eval/run.ts",
    "dev": "pnpm generate:agent-docs && unbuild --stub",
    "relizy": "tsx src/cli.ts",
    "rly": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:fix": "cross-env NODE_ENV=production eslint . --fix",
    "lint:all": "pnpm lint && pnpm lint:docs",
    "lint:fix:all": "pnpm lint:fix && pnpm lint:docs:fix",
    "lint:docs": "cross-env NODE_ENV=production pnpm -F docs lint",
    "lint:docs:fix": "pnpm lint:docs --fix",
    "test:unit": "pnpm generate:agent-docs && vitest run",
    "test:unit:watch": "pnpm generate:agent-docs && vitest watch",
    "test:unit:coverage": "pnpm generate:agent-docs && vitest run --coverage",
    "health": "pnpm typecheck && pnpm -F docs typecheck && pnpm lint:fix:all && pnpm test:unit:coverage && pnpm build && pnpm -F docs build",
    "pre-commit": "lint-staged"
  },
  "peerDependencies": {
    "@slack/web-api": "^7.0.0 || ^8.0.0",
    "@yoloship/claude-sdk": "^0.2.0-beta.6",
    "ai": "^7.0.0",
    "twitter-api-v2": "^1.20.0"
  },
  "peerDependenciesMeta": {
    "@slack/web-api": {
      "optional": true
    },
    "@yoloship/claude-sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "twitter-api-v2": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@maz-ui/node": "5.2.0",
    "@maz-ui/utils": "5.2.0",
    "c12": "^3.3.4",
    "commander": "^15.0.0",
    "confbox": "^0.3.2",
    "convert-gitmoji": "^0.1.5",
    "defu": "6.1.7",
    "fast-glob": "^3.3.3",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromatch": "^4.0.8",
    "node-fetch-native": "^1.6.7",
    "oxc-parser": "^0.157.0",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@maz-ui/eslint-config": "5.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@slack/web-api": "8.3.0",
    "@types/mdast": "^4.0.4",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@yoloship/claude-sdk": "0.2.0-beta.9",
    "ai": "^7.0.162",
    "cross-env": "10.1.0",
    "eslint": "^10.14.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "^17.6.0",
    "memfs": "^4.80.0",
    "minisearch": "^7.2.0",
    "tsx": "^4.23.15",
    "twitter-api-v2": "^1.31.0",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,md,yml,json}": [
      "eslint --fix"
    ]
  }
}
