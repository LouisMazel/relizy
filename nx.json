{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "develop",
  "neverConnectToCloud": true,
  "analytics": false,
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tsconfig.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/vitest.*",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/CLAUDE.md"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", { "externalDependencies": ["unbuild"] }],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false
    },
    "typecheck": {
      "inputs": ["default", "^production", "{workspaceRoot}/tests/**/*", "{workspaceRoot}/relizy.config.ts", { "externalDependencies": ["typescript"] }],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/eslint.config.ts", "{projectRoot}/eslint.config.ts", { "externalDependencies": ["eslint"] }],
      "cache": true
    },
    "lint:fix": {
      "cache": false
    },
    "test:unit": {
      "inputs": ["default", "^production", "{workspaceRoot}/tests/**/*", "{workspaceRoot}/vitest.config.ts", { "env": "TZ" }, { "externalDependencies": ["vitest"] }],
      "cache": true
    }
  }
}
