{
  "mcpServers": {
    "maz-ui": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@maz-ui/mcp@latest"
      ]
    },
    "relizy": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "exec",
        "tsx",
        "src/cli.ts",
        "mcp"
      ]
    }
  }
}
